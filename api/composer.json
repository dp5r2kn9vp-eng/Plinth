{
    "name": "plinth/api",
    "description": "Plinth PHP-API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "Plinth\\Api\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Plinth\\Api\\Tests\\": "tests/" }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "test": "phpunit"
    },
    "config": { "sort-packages": true }
}
