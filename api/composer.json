{
    "name": "plinth/api",
    "description": "Plinth PHP-API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "aws/aws-sdk-php": "^3.300",
        "opis/json-schema": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Plinth\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plinth\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "test": "phpunit",
        "pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "aws/aws-sdk-php": [
            "S3"
        ]
    }
}
