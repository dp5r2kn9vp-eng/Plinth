{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plinth.klangniveau.de/schemas/layout.schema.json",
  "title": "Plinth Layout",
  "description": "Gesamte Bildschirmmaske eines Projekts. Koordinaten in Pixeln relativ zur Zeichenfläche (canvas); der Player skaliert auf die echte Bildschirmauflösung.",
  "type": "object",
  "required": ["schemaVersion", "canvas", "startPage", "pages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width":  { "type": "integer", "minimum": 320, "maximum": 7680, "default": 1920 },
        "height": { "type": "integer", "minimum": 240, "maximum": 4320, "default": 1080 }
      }
    },
    "startPage": { "type": "string", "description": "id der Startseite (Homescreen)" },
    "idleTimeoutSeconds": { "type": "integer", "minimum": 0, "default": 0, "description": "Rückkehr zum Homescreen nach Inaktivität im Video; 0 = aus" },
    "pages": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
    "background": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["color", "image"] },
        "color": { "$ref": "#/$defs/color" },
        "assetId": { "$ref": "#/$defs/id" },
        "fit": { "enum": ["cover", "contain", "stretch"], "default": "cover" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "color" } } }, "then": { "required": ["color"] } },
        { "if": { "properties": { "type": { "const": "image" } } }, "then": { "required": ["assetId"] } }
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["id", "type", "elements"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["home", "video"], "description": "home = Seite mit Elementen; video = Abspielseite mit Kopfzeile" },
        "name": { "type": "string", "maxLength": 120 },
        "background": { "$ref": "#/$defs/background" },
        "header": { "$ref": "#/$defs/header" },
        "videoArea": { "$ref": "#/$defs/rect" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "video" } } }, "then": { "required": ["header", "videoArea"] } }
      ]
    },
    "header": {
      "type": "object",
      "description": "Kopfzeile der Videoseite mit Zurück-Button zum Homescreen",
      "required": ["height"],
      "additionalProperties": false,
      "properties": {
        "height": { "type": "integer", "minimum": 40, "maximum": 400 },
        "color": { "$ref": "#/$defs/color" },
        "title": { "type": "string", "maxLength": 200 },
        "titleColor": { "$ref": "#/$defs/color" },
        "backLabel": { "type": "string", "maxLength": 40, "default": "Zurück" },
        "backAssetId": { "$ref": "#/$defs/id", "description": "optionales eigenes Icon für den Zurück-Button" }
      }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "elementBase": {
      "type": "object",
      "required": ["id", "type", "x", "y", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["text", "image", "thumbnail", "button"] },
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "z": { "type": "integer", "default": 0, "description": "Ebene, höhere Werte liegen vorne" },
        "rotation": { "type": "number", "default": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "visible": { "type": "boolean", "default": true }
      }
    },
    "element": {
      "allOf": [ { "$ref": "#/$defs/elementBase" } ],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "maxLength": 5000 },
            "fontFamily": { "type": "string", "default": "sans-serif" },
            "fontSize": { "type": "number", "minimum": 6 },
            "fontWeight": { "enum": ["normal", "bold"], "default": "normal" },
            "color": { "$ref": "#/$defs/color" },
            "align": { "enum": ["left", "center", "right"], "default": "left" }
          },
          "required": ["type", "text", "fontSize"]
        },
        {
          "properties": {
            "type": { "const": "image" },
            "assetId": { "$ref": "#/$defs/id" },
            "fit": { "enum": ["cover", "contain", "stretch"], "default": "contain" }
          },
          "required": ["type", "assetId"]
        },
        {
          "properties": {
            "type": { "const": "thumbnail" },
            "videoAssetId": { "$ref": "#/$defs/id", "description": "Video, das beim Klick auf der Videoseite abgespielt wird" },
            "posterAssetId": { "$ref": "#/$defs/id", "description": "eigenes Vorschaubild; sonst automatisches Standbild" },
            "targetPage": { "$ref": "#/$defs/id", "description": "Videoseite; Standard: erste Seite vom Typ video" },
            "caption": { "type": "string", "maxLength": 200 },
            "cornerRadius": { "type": "number", "minimum": 0, "default": 0 }
          },
          "required": ["type", "videoAssetId"]
        },
        {
          "properties": {
            "type": { "const": "button" },
            "label": { "type": "string", "maxLength": 80 },
            "color": { "$ref": "#/$defs/color" },
            "textColor": { "$ref": "#/$defs/color" },
            "action": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "enum": ["goto_page", "home"] },
                "page": { "$ref": "#/$defs/id" }
              },
              "additionalProperties": false
            }
          },
          "required": ["type", "label", "action"]
        }
      ]
    }
  }
}
