APP_URL=https://plinth.klangniveau.de
APP_ENV=production
APP_DEBUG=false
# Pfad, unter dem die API erreichbar ist (Endpunkte: /api/v1/...)
API_BASE_PATH=/api
# Logdatei (Standard: api/storage/logs/api.log)
LOG_PATH=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Sitzungen der Designer-Benutzer
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30
# Nur für lokale Entwicklung ohne HTTPS auf false setzen
SESSION_COOKIE_SECURE=true

# S3-kompatibler Speicher, z. B. https://<account>.r2.cloudflarestorage.com oder https://fsn1.your-objectstorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_PATH_STYLE=true
# SHA-256 pro Upload-Teil vom Speicher prüfen lassen (bei Problemen mit einem Anbieter auf false)
S3_PART_CHECKSUMS=true

# Schlüssel für pruefung.php (Prüfseite) und cron.php (Cronjob per URL), je mind. 20 zufällige Zeichen.
# CHECK_TOKEN nach der Einrichtung wieder entfernen.
CHECK_TOKEN=
CRON_TOKEN=
S3_BUCKET=
S3_KEY=
S3_SECRET=

# Maximale Dateigröße für Uploads in GB
UPLOAD_MAX_GB=20
# Gültigkeit der Download-Links für Player in Stunden
DOWNLOAD_URL_TTL_HOURS=6
# Pfad zu shared/schemas, falls nicht neben api/ abgelegt
SCHEMA_PATH=
