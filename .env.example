APP_URL=https://plinth.klangniveau.de
APP_ENV=production
APP_DEBUG=false
# Pfad, unter dem die API erreichbar ist (Endpunkte: /api/v1/...)
API_BASE_PATH=/api
# Logdatei (Standard: api/storage/logs/api.log)
LOG_PATH=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Sitzungen der Designer-Benutzer
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30
# Nur für lokale Entwicklung ohne HTTPS auf false setzen
SESSION_COOKIE_SECURE=true

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_KEY=
S3_SECRET=
